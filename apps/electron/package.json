{
  "name": "@craft-agent/electron",
  "productName": "Robb Agents",
  "desktopName": "Robb Agents",
  "version": "0.12.11",
  "description": "Electron desktop app for Robb Agents",
  "main": "dist/main.cjs",
  "private": true,
  "author": {
    "name": "Robb Agents Contributors"
  },
  "homepage": "https://github.com/robinswood-io/robb-agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/robinswood-io/robb-agents.git"
  },
  "bugs": {
    "url": "https://github.com/robinswood-io/robb-agents/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:main": "bun run ../../scripts/electron-build-main.ts --main-only",
    "build:main:win": "bun run ../../scripts/electron-build-main.ts --main-only",
    "build:preload": "esbuild src/preload/bootstrap.ts --bundle --platform=node --format=cjs --outfile=dist/bootstrap-preload.cjs --external:electron",
    "build:preload-toolbar": "esbuild src/preload/browser-toolbar.ts --bundle --platform=node --format=cjs --outfile=dist/browser-toolbar-preload.cjs --external:electron",
    "build:interceptor": "esbuild ../../packages/shared/src/unified-network-interceptor.ts --bundle --platform=node --format=cjs --outfile=dist/interceptor.cjs",
    "build:renderer": "vite build",
    "build:copy": "bun scripts/copy-assets.ts",
    "build:validate": "bun scripts/validate-assets.ts",
    "build": "bun run lint && bun run --cwd ../.. electron:build",
    "build:win": "bun run build:main:win && bun run build:preload && bun run build:preload-toolbar && bun run build:interceptor && bun run build:renderer && bun run build:copy && bun run build:validate",
    "start": "bun run build && electron .",
    "start:win": "bun run build:win && electron .",
    "dev": "vite dev",
    "typecheck": "node ../../scripts/run-typescript.ts native --noEmit",
    "dist:mac": "bash scripts/build-dmg.sh arm64",
    "dist:mac:x64": "bash scripts/build-dmg.sh x64",
    "dist:win": "powershell -ExecutionPolicy Bypass -File scripts/build-win.ps1",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "@craft-agent/core": "workspace:*",
    "@craft-agent/messaging-gateway": "workspace:*",
    "@craft-agent/server-core": "workspace:*",
    "@craft-agent/shared": "workspace:*",
    "@craft-agent/ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@paper-design/shaders-react": "^0.0.82",
    "@pierre/diffs": "^1.6.2",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@tanstack/react-table": "^9.3.1",
    "chrono-node": "^2.10.3",
    "cmdk": "^1.1.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.11",
    "i18next-browser-languagedetector": "8.2.4",
    "jotai-family": "^1.1.0",
    "motion": "^14.9.0",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-pdf": "^11.0.0",
    "react-simple-code-editor": "^0.14.1",
    "remark": "^15.0.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "strip-markdown": "^6.0.0",
    "undici": "8.12.3",
    "unist-util-visit": "^5.2.0",
    "vaul": "^1.1.2",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  }
}
