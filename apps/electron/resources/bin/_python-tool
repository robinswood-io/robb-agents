#!/bin/sh
set -eu

tool_script=${1:?missing bundled Python tool script name}
shift

bin_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
scripts_dir=${CRAFT_SCRIPTS:-"$bin_dir/../scripts"}

if [ -n "${CRAFT_UV:-}" ]; then
  uv_bin=$CRAFT_UV
else
  case "$(uname -s)" in
    Darwin) platform=darwin ;;
    Linux) platform=linux ;;
    *) platform=unknown ;;
  esac
  case "$(uname -m)" in
    arm64|aarch64) arch=arm64 ;;
    x86_64|amd64) arch=x64 ;;
    *) arch=$(uname -m) ;;
  esac
  bundled_uv="$bin_dir/$platform-$arch/uv"
  if [ -x "$bundled_uv" ]; then
    uv_bin=$bundled_uv
  else
    uv_bin=$(command -v uv || true)
  fi
fi

if [ -z "${uv_bin:-}" ] || [ ! -x "$uv_bin" ]; then
  echo "Bundled Python tool runtime not found. Expected CRAFT_UV or $bin_dir/<platform>/uv." >&2
  exit 127
fi
if [ ! -f "$scripts_dir/$tool_script" ]; then
  echo "Bundled Python tool script not found: $scripts_dir/$tool_script" >&2
  exit 127
fi

exec "$uv_bin" run --python 3.12 "$scripts_dir/$tool_script" "$@"
