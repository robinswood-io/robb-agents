{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "./dist",
    "declaration": true,
    "declarationDir": "./dist",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "types": [
      "node",
      "vite/client",
      "bun"
    ],
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@craft-agent/core": [
        "../core/src/index.ts"
      ],
      "@craft-agent/core/*": [
        "../core/src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "eslint-rules/**/*.ts",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
