{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rootDir": "../..",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "types": [
      "bun",
      "node"
    ],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@craft-agent/shared": [
        "../shared/src/index.ts"
      ],
      "@craft-agent/shared/*": [
        "../shared/src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
