{
  "name": "@craft-agent/pi-agent-server",
  "version": "0.11.5",
  "license": "MIT",
  "description": "Out-of-process Pi agent server communicating via JSONL over stdio",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pi-agent-server": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts src/vibe-acp-server.ts --outdir=dist --target=bun --format=esm --external koffi",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "validate": "bun run typecheck && bun run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@sinclair/typebox": "^0.34.0",
    "duck-duck-scrape": "^2.2.7",
    "node-html-parser": "^9.0.1",
    "pdfjs-dist": "^6.2.108",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
