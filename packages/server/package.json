{
  "name": "@craft-agent/server",
  "version": "0.12.4",
  "description": "Standalone headless Craft Agent server (Bun runtime)",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "craft-server": "src/index.ts"
  },
  "files": [
    "src/"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "author": {
    "name": "Craft Docs Ltd.",
    "email": "support@craft.do"
  },
  "license": "MIT",
  "homepage": "https://agents.craft.do",
  "scripts": {
    "start": "bun run src/index.ts",
    "generate-token": "bun run src/index.ts --generate-token",
    "typecheck": "node ../../scripts/run-typescript.mjs native --noEmit"
  },
  "dependencies": {
    "@craft-agent/core": "workspace:*",
    "@craft-agent/messaging-gateway": "workspace:*",
    "@craft-agent/server-core": "workspace:*",
    "@craft-agent/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "@types/node": "^24.13.3",
    "ws": "^8.16.0"
  }
}
